# Supabase project URL and publishable key (Project Settings > API keys).
# The app never needs the secret key: privileged writes go through Postgres functions.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Speaking room: a relay (TURN) for networks that block a direct call, such as a
# VPN, mobile data or an office network. Without one the room only works when
# both devices can reach each other directly.
# Cloudflare Realtime TURN (dash.cloudflare.com > Realtime > TURN Server > Create):
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Or any other TURN service with fixed credentials:
# TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
